# ===========================================================================
# Lantern — environment template
# ===========================================================================
# Copy this file to ".env" and fill in your keys.
# .env is gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# TIER A — needed for module 1 (research.py)
# ---------------------------------------------------------------------------

# YouTube Data API v3 — server API key (read-only research queries)
# Get at: https://console.cloud.google.com/apis/credentials -> "Create API key"
YOUTUBE_API_KEY=

# Pexels — stock photo/video API key
# Get at: https://www.pexels.com/api/  (sign up -> "Your API key")
PEXELS_API_KEY=

# Pixabay — stock photo/video API key
# Get at: https://pixabay.com/api/docs/  (log in -> key shown on page)
PIXABAY_API_KEY=

# ---------------------------------------------------------------------------
# TIER B — needed for module 6 (upload.py)
# ---------------------------------------------------------------------------

# Path to the YouTube OAuth client_secret JSON (Desktop app type).
# This file authorizes uploads to YOUR YouTube channel.
# Recommended location: secrets/client_secret.json
YOUTUBE_OAUTH_CLIENT_JSON=secrets/client_secret.json

# Where the saved OAuth refresh token is cached after one-time authorization.
YOUTUBE_TOKEN_CACHE=secrets/youtube_token.json

# ---------------------------------------------------------------------------
# TIER C — optional / later
# ---------------------------------------------------------------------------

# LLM provider for script.py (manual mode is default — leave as "none" to use $0 mode)
# Options: none, gemini, anthropic, openai, groq
LLM_PROVIDER=none

# API key for the chosen provider (leave blank for manual mode)
LLM_API_KEY=

# Default model when LLM_PROVIDER != none (gemini-2.0-flash is free-tier friendly)
LLM_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Pipeline behavior
# ---------------------------------------------------------------------------

# Active channel config (file under channels/<name>.yaml)
ACTIVE_CHANNEL=india

# Max disk cache for stock-asset downloads (gigabytes)
STOCK_CACHE_MAX_GB=5
